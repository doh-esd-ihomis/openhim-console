{
	"name": "openhim-console",
	"description": "This application provides a web application to configure and manage the OpenHIM-core component.",
	"version": "1.19.0",
	"dependencies": {
		"core-js": "^3.36.0",
		"http-server": "^14.1.1",
		"keycloak-js": "^26.0.0",
		"regenerator-runtime": "^0.14.1",
		"uuid": "^11.0.0"
	},
	"security": {
		"bootstrap": {
			"version": "3.4.1",
			"status": "known-vulnerability-accepted",
			"reason": "angular-ui-bootstrap (required for AngularJS 1.x) only supports Bootstrap 3. Upgrading to Bootstrap 5 breaks 30+ templates using BS3 classes (panel-*, glyphicon-*, well, navbar-*). This is an internal admin console, not public-facing. All other dependencies are current.",
			"mitigation": "Monitor for security advisories. Long-term: migrate from AngularJS 1.x or replace angular-ui-bootstrap with custom directives."
		}
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@kariudo/angular-fullscreen": "^1.0.2",
		"angular": "^1.8.3",
		"angular-bootstrap-colorpicker": "^3.0.32",
		"angular-cookies": "^1.8.2",
		"angular-file-upload": "^2.6.1",
		"angular-highlightjs": "^0.5.1",
		"angular-mocks": "^1.8.2",
		"angular-resource": "^1.8.2",
		"angular-route": "^1.8.2",
		"angular-sanitize": "^1.8.2",
		"angular-ui-bootstrap": "^2.5.6",
		"babel-loader": "^9.1.3",
		"bootstrap": "^3.4.1",
		"chai": "^4.5.0",
		"chart.js": "^4.4.0",
		"copy-webpack-plugin": "^12.0.2",
		"crypto-js": "^4.2.0",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^6.0.0",
		"d3": "^7.9.0",
		"dirty-chai": "^2.0.1",
		"eonasdan-bootstrap-datetimepicker": "^4.17.49",
		"eslint": "^8.57.0",
		"eslint-plugin-angular": "^5.1.0",
		"file-loader": "^6.2.0",
		"file-saver": "^2.0.5",
		"highlight.js": "^10.7.3",
		"html-loader": "^5.1.0",
		"html-webpack-plugin": "^5.6.0",
		"jquery": "^3.7.1",
		"karma": "^6.4.4",
		"karma-chrome-launcher": "^3.2.0",
		"karma-mocha": "^2.0.1",
		"karma-mocha-reporter": "^2.2.5",
		"karma-sinon-chai": "^2.0.2",
		"lodash": "^4.17.21",
		"mini-css-extract-plugin": "^2.9.0",
		"mocha": "^12.0.3",
		"moment": "^2.30.1",
		"moment-timezone": "^0.5.45",
		"morris.js": "git+https://github.com/morrisjs/morris.js.git#77c24f6b70df2b23c7bd5d4d67240850d1b83005",
		"ng-file-upload": "^12.2.13",
		"postcss-import": "^16.0.1",
		"postcss-loader": "^8.1.1",
		"prettier": "^3.2.0",
		"pretty-data": "^0.40.0",
		"raphael": "^2.3.0",
		"sinon": "^17.0.0",
		"sinon-chai": "^3.7.0",
		"speculate": "^2.1.1",
		"style-loader": "^4.0.0",
		"terser-webpack-plugin": "^5.3.10",
		"url-loader": "^4.1.1",
		"webpack": "^5.91.0",
		"webpack-bundle-analyzer": "^4.10.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.0.4",
		"webpack-merge": "^5.10.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"eslintConfig": {
		"env": {
			"browser": true,
			"es2021": true,
			"node": true
		},
		"extends": [
			"eslint:recommended",
			"plugin:angular/johnpapa"
		],
		"parserOptions": {
			"ecmaVersion": "latest",
			"sourceType": "module"
		},
		"plugins": [
			"angular"
		],
		"globals": {
			"angular": "readonly",
			"localStorage": "readonly",
			"Blob": "readonly",
			"sessionStorage": "readonly",
			"FileReader": "readonly",
			"$": "readonly",
			"moment": "readonly",
			"d3": "readonly",
			"Chart": "readonly",
			"Keycloak": "readonly"
		},
		"rules": {
			"angular/controller-as": "error",
			"angular/no-private-call": "warn",
			"no-unused-vars": [
				"error",
				{
					"argsIgnorePattern": "^_"
				}
			],
			"angular/module-getter": "off",
			"angular/file-name": "off",
			"angular/controller-as-route": "off",
			"angular/no-run-logic": "off",
			"angular/window-service": "off",
			"angular/interval-service": "off",
			"angular/document-service": "off",
			"angular/timeout-service": "off",
			"angular/function-type": "off",
			"angular/directive-restrict": "off",
			"angular/module-setter": "off",
			"no-extra-semi": "off",
			"no-prototype-builtins": "off",
			"no-useless-escape": "off"
		},
		"overrides": [
			{
				"files": [
					"test/**/*.js"
				],
				"env": {
					"mocha": true
				},
				"globals": {
					"inject": "readonly",
					"sinon": "readonly",
					"expect": "readonly",
					"window": "readonly"
				},
				"rules": {
					"no-redeclare": "off",
					"angular/controller-as": "off",
					"no-unused-vars": [
						"error",
						{
							"argsIgnorePattern": "^_"
						}
					]
				}
			},
			{
				"files": [
					"app/scripts/external/**/*.js"
				],
				"rules": {
					"no-unused-vars": [
						"error",
						{
							"argsIgnorePattern": "^_"
						}
					]
				}
			}
		]
	},
	"prettier": {
		"singleQuote": true,
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"printWidth": 120,
		"bracketSpacing": true,
		"trailingComma": "es5"
	},
	"scripts": {
		"start": "http-server ./dist -p 9000",
		"start:dev": "webpack-dev-server --config webpack.development.js",
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"lint": "eslint 'app/**/*.js' 'test/**/*.js'",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier --write \"app/**/*.js\" \"test/**/*.js\" \"webpack*.js\" \"*.json\" \"*.md\"",
		"format:check": "prettier --check \"app/**/*.js\" \"test/**/*.js\" \"webpack*.js\" \"*.json\" \"*.md\"",
		"test": "karma start --single-run",
		"test:watch": "karma start --auto-watch",
		"prepare": "npm run clean && npm run build:prod",
		"build": "webpack --config webpack.development.js",
		"build:prod": "node --max_old_space_size=4096 node_modules/webpack/bin/webpack.js --config webpack.production.js",
		"build:analyze": "npm run build:prod && npx webpack-bundle-analyzer dist/stats.json",
		"version": "node versionManager.js && git add -u",
		"spec": "speculate"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jembi/openhim-console.git"
	},
	"keywords": [
		"openhim",
		"openhie"
	],
	"author": "Jembi Health Systems NPC",
	"license": "MPL-2.0",
	"bugs": {
		"url": "https://github.com/jembi/openhim-console/issues"
	},
	"homepage": "http://openhim.org"
}
